{
  "version": 2,
  "builds": [
    { "src": "api/*.py", "use": "@vercel/python" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/roles", "dest": "/api/roles.py" },
    { "src": "/api/report", "dest": "/api/report.py" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
